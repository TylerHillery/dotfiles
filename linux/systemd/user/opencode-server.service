[Unit]
Description=OpenCode HTTP server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -lc 'exec mise exec -- opencode serve --hostname 127.0.0.1 --port 4096'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
